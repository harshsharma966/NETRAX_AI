# Environment Variables Example
ENV=development
APP_NAME=Netrax_AI
DEVICE=cpu
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=netrax_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Paths
EMBEDDINGS_PATH=data/face_embeddings/registered_embeddings.npz
DEFAULT_CAMERA_SOURCE=0
PHOTO_UPLOAD_DIR=captures/uploads
PORT=5000
